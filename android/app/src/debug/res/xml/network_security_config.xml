<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG ONLY (overrides main/res/xml/network_security_config.xml with the same name). Cleartext is allowed
     so the dev loop can use ws://127.0.0.1 through adb reverse and a laptop on the LAN over ws://.
     Release builds never contain this file. See docs/ANDROID_TLS_POLICY.md. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
