LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_VISION=1

# Push Notifications (dashboard_only | telegram | whatsapp | multi)
NOTIFY_MODE=dashboard_only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=

# Security & Access Control
BTB_AUTH_ENABLED=0
BTB_DASHBOARD_PIN=
BTB_INGEST_TOKEN=
BTB_API_TOKEN=

# Pipeline & Demo Mode
DEMO_MODE=0
WEB_PIPELINE=real

# Database & Persistence (Default: sqlite:///out/btb.db; Supabase or external PostgreSQL in prod)
BTB_DATABASE_URL=sqlite:///out/btb.db
# Example Supabase direct connection or transaction pooler:
# BTB_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Cloudflare R2 / S3 Object Storage for Alert Snapshots (Optional)
# If left blank, alert snapshots fall back to inlined base64 data URIs
BTB_R2_ACCOUNT_ID=
BTB_R2_ACCESS_KEY_ID=
BTB_R2_SECRET_ACCESS_KEY=
BTB_R2_BUCKET=btb-snapshots
BTB_R2_PRESIGNED_TTL_S=900
# BTB_R2_PUBLIC_URL=https://custom-domain.example.com

# Android Release Signing (Optional)
BTB_KEYSTORE_PATH=release.jks
BTB_KEYSTORE_PASSWORD=behindthebarks
BTB_KEY_ALIAS=btb_release
BTB_KEY_PASSWORD=behindthebarks
